# File: .env.example
# Purpose: template for local settings. Copy it to .env (cp .env.example .env).
# Never commit .env with real keys.
# Comments are on their own lines so every tool reads the values correctly.

# Time zone used by n8n (e.g. for schedules)
GENERIC_TIMEZONE=Europe/Berlin
# Time zone of the container system
TZ=Europe/Berlin
# Only for scripts/export_traces.py; create it in n8n under Settings -> n8n API
N8N_API_KEY=
# Optional: export only this workflow (ID from the workflow URL)
N8N_WORKFLOW_ID=
